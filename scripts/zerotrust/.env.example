# Copy to .env (same folder) and fill in.
# .env is gitignored by the root .gitignore — never commit real values.

# Personal Access Token from https://airtable.com/create/tokens
# Scopes needed: data.records:read, data.records:write
# Access: ONLY the base you target with AIRTABLE_BASE_ID (least-privilege)
AIRTABLE_TOKEN=

# Base ID from the URL of your base: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=

# Set to 1 to preview what would be uploaded without calling the API.
# Useful before the first real run.
AIRTABLE_DRY_RUN=

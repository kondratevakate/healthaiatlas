# Managed by ansible/playbook.yml — do not edit in place.

server {
    listen 80;
    listen [::]:80;
    server_name {{ server_name }};

    root {{ doc_root }};
    index index.html;

    # SPA fallback: any unknown path returns index.html so react-router handles it.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache immutable assets (Vite emits hashed filenames in dist/assets/).
    location ~* \.(?:js|css|woff2?|ttf|otf|eot|png|jpg|jpeg|gif|svg|ico|webp|avif|mp4|webm|ogg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must never be cached — it references hashed bundles that change on every deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Deny access to dotfiles
    location ~ /\. {
        deny all;
    }
}

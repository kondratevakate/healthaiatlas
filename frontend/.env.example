# Set to "on" to expose the Discovery Copilot chat sidebar on /discovery.
# Leave empty in production until the upstream LLM endpoints + auth are stable.
VITE_DISCOVERY_COPILOT=

# Optional newsletter signup endpoint (Cloudflare Worker that forwards to a CRM).
# When unset, the Subscribe modal stores emails in localStorage only.
VITE_NEWSLETTER_SIGNUP_URL=

# Optional API key for the Discovery Copilot's authenticated provider mode.
# Either points at OpenRouter / Groq / Together with a bearer token, or at
# our own proxy Worker (then leave empty here, key lives on the Worker).
VITE_AI_INSIGHTS_API_KEY=
VITE_AI_INSIGHTS_URL=

# Optional HuggingFace inference token used as a fallback in the Copilot chain.
VITE_HUG_API_KEY=

# Optional Cloudflare Web Analytics site token (cookieless visit counter).
# Cloudflare dashboard -> Web Analytics -> Add site -> copy the token from the JS snippet.
VITE_CF_BEACON_TOKEN=

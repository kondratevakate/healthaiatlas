#!/usr/bin/env python3
# Pre-commit review hook — pipes the staged diff to Claude Haiku and prints
# a short summary + risk flags. Always exits 0 (informational, not a gate).
#
# Activate: git config core.hooksPath .githooks
# Bypass:   SKIP_REVIEW=1 git commit ...
# Auth:     ANTHROPIC_API_KEY env var, or first line of ~/.anthropic_key

import json
import os
import pathlib
import subprocess
import sys
import urllib.error
import urllib.request

MODEL = "claude-haiku-4-5-20251001"
MAX_DIFF_CHARS = 60_000  # truncate huge diffs so the call stays cheap
TIMEOUT_S = 30


def green(s): return f"\033[32m{s}\033[0m"
def yellow(s): return f"\033[33m{s}\033[0m"
def red(s): return f"\033[31m{s}\033[0m"
def dim(s): return f"\033[2m{s}\033[0m"


def get_api_key() -> str | None:
    key = os.environ.get("ANTHROPIC_API_KEY", "").strip()
    if key:
        return key
    keyfile = pathlib.Path.home() / ".anthropic_key"
    if keyfile.exists():
        first = keyfile.read_text(encoding="utf-8").strip().splitlines()
        if first:
            return first[0].strip()
    return None


def get_staged_diff() -> str:
    try:
        out = subprocess.check_output(
            ["git", "diff", "--cached", "--no-color"],
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return ""
    return out.decode("utf-8", errors="replace")


def get_staged_files() -> list[str]:
    try:
        out = subprocess.check_output(
            ["git", "diff", "--cached", "--name-only"],
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return []
    return [line for line in out.decode().splitlines() if line.strip()]


def call_claude(api_key: str, diff: str, files: list[str]) -> str:
    truncated = diff[:MAX_DIFF_CHARS]
    if len(diff) > MAX_DIFF_CHARS:
        truncated += f"\n\n[... diff truncated, {len(diff) - MAX_DIFF_CHARS} chars omitted ...]"

    prompt = f"""You are reviewing a git commit before it lands. Be terse.

Files changed:
{chr(10).join('- ' + f for f in files)}

Staged diff:
```diff
{truncated}
```

Reply with exactly three short paragraphs (no headers, no bold, no bullets):
1. WHAT — one sentence describing the change in plain English.
2. CHECK — one sentence on what the author should verify before pushing (test coverage, regressions, side effects).
3. RISK — one sentence flagging real risks (secrets, PII, broken contracts, hallucination-prone changes); say "no obvious risk" if none.

Be specific. Reference actual file or function names. No fluff."""

    body = json.dumps({
        "model": MODEL,
        "max_tokens": 600,
        "messages": [{"role": "user", "content": prompt}],
    }).encode("utf-8")

    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages",
        data=body,
        headers={
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
        data = json.loads(resp.read())
    parts = data.get("content", [])
    text = "\n".join(p.get("text", "") for p in parts if p.get("type") == "text")
    return text.strip()


def main() -> int:
    if os.environ.get("SKIP_REVIEW") == "1":
        return 0

    diff = get_staged_diff()
    if not diff.strip():
        return 0

    files = get_staged_files()

    api_key = get_api_key()
    if not api_key:
        print(dim("[pre-commit] ANTHROPIC_API_KEY not set, skipping Claude review."), file=sys.stderr)
        print(dim("            export ANTHROPIC_API_KEY=... or put it in ~/.anthropic_key"), file=sys.stderr)
        return 0

    print(dim(f"[pre-commit] asking Claude ({MODEL}) to review {len(files)} file(s)..."), file=sys.stderr)
    try:
        review = call_claude(api_key, diff, files)
    except urllib.error.HTTPError as e:
        print(yellow(f"[pre-commit] Claude review failed: HTTP {e.code} {e.reason}"), file=sys.stderr)
        try:
            err_body = e.read().decode("utf-8", errors="replace")[:500]
            print(dim(err_body), file=sys.stderr)
        except Exception:
            pass
        return 0
    except Exception as e:
        print(yellow(f"[pre-commit] Claude review failed: {type(e).__name__}: {e}"), file=sys.stderr)
        return 0

    print("", file=sys.stderr)
    print(green("─" * 60), file=sys.stderr)
    print(green("Claude review (informational — does not block commit)"), file=sys.stderr)
    print(green("─" * 60), file=sys.stderr)
    print(review, file=sys.stderr)
    print(green("─" * 60), file=sys.stderr)
    print(dim("Bypass with: SKIP_REVIEW=1 git commit ..."), file=sys.stderr)
    print("", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
